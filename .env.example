# Copiez en .env. Les clés restent exclusivement côté backend.
# true = réponses de démonstration locales, aucun appel payant.
# Passez à false et renseignez LLM_API_KEY pour discuter avec une vraie IA.
DEMO_MODE=true

# API compatible OpenAI. OpenRouter permet plusieurs modèles avec une seule clé.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
DEFAULT_MODEL=openai/gpt-4o-mini
LLM_MODELS='[{"id":"openai/gpt-4o-mini","name":"GPT-4o mini","vision":true},{"id":"google/gemini-2.5-flash-lite","name":"Gemini 2.5 Flash Lite","vision":true},{"id":"mistralai/mistral-small-3.2-24b-instruct","name":"Mistral Small 3.2","vision":true}]'

# Outils facultatifs. Sans clé, leurs boutons sont désactivés.
BRAVE_API_KEY=
MISTRAL_API_KEY=
IDEOGRAM_API_KEY=
# Hôtes exacts autorisés pour télécharger les images retournées par Ideogram.
# Ajoutez un autre CDN seulement après vérification, ainsi qu'à la règle réseau cloud.
IDEOGRAM_IMAGE_HOSTS=ideogram.ai

# En local sans Docker : SQLite et fichiers dans backend/data.
# Compose remplace DATABASE_URL par l'adresse PostgreSQL interne.
DATABASE_URL=sqlite:///./data/tchatai.db
APP_DATA_DIR=./data
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
MAX_UPLOAD_MB=20
MAX_CONTEXT_CHARS=60000
SUMMARY_EVERY_MESSAGES=12
MAX_SUMMARY_CHARS=6000

# Mot de passe de développement, remplacé aléatoirement par install.sh.
# Ne réutilisez pas cette valeur pour une instance exposée à Internet.
POSTGRES_PASSWORD=replace-with-random-local-password
